--- !u!114 &910000311
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2017715477}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7a4e1c9b2d8f4e6a9c0b1d2e3f4a5b6c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  interactionId: parents
  speakerName: Mom
  prompt: Talk
  lines:
  - That box was marked Ship. Then I changed my mind.
  - We can buy new plates. We can't replace what your grandpa left behind.
  - The photo on the wall is the summer festival. He still has the flute in his hands.
  - It's waiting upstairs. He always said it should go to you.
  facePlayer: 1
  promptHeight: 1.6
