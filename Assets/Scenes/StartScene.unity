  m_Name: 
  m_EditorClassIdentifier: 
  interactionId: painting
  speakerName: Photo
  prompt: Look
  lines:
  - A photo from a summer festival. Everyone looks younger.
  - Grandpa stands in the middle, laughing, with the flute at his lips.
  - The lanterns behind him are the same ones still sitting in the hall closet.
  - "On the back, his handwriting reads: For the one who comes after."
  facePlayer: 0
  promptHeight: 0.4
