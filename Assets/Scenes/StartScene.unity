  m_Name: 
  m_EditorClassIdentifier: 
  speakerName: "旅人"
  prompt: "交谈"
  lines:
  - "我路过的时候，石狮子的眼睛还亮着一闪，然后就黑了。"
  - "闸门上的灯是跟着它一起灭的。你要过去，得先弄明白那座石狮。"
  facePlayer: 1
  promptHeight: 1.2
