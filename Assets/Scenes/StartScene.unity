--- !u!114 &910000321
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1737907671}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7a4e1c9b2d8f4e6a9c0b1d2e3f4a5b6c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  interactionId: brother
  speakerName: Brother
  prompt: Talk
  lines:
  - Don't step on my river. I'm bringing all these toys when we move.
  - Grandpa made the little boats. He said this river runs all the way to the festival.
  - Mom says everything has to be in a box tonight. I don't want to leave his house.
  - The flute upstairs is his. He told me it belongs to you.
  facePlayer: 1
  promptHeight: 1.1
