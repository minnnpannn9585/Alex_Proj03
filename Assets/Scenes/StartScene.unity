--- !u!114 &910000351
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 586410331}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7a4e1c9b2d8f4e6a9c0b1d2e3f4a5b6c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  interactionId: flute
  speakerName: Flute
  prompt: Take
  lines:
  - This is Grandpa's flute. The wood is still warm, as if he just set it down.
  - The summer from the photo feels close enough to touch.
  - Take it, and you can travel through time.
  - One breath, and that old day opens.
  facePlayer: 0
  promptHeight: 0.8
