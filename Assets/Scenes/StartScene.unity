--- !u!114 &910000301
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 973598533}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7a4e1c9b2d8f4e6a9c0b1d2e3f4a5b6c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  interactionId: parents
  speakerName: Dad
  prompt: Talk
  lines:
  - The books go in the box marked Keep, though I think I labeled it wrong again.
  - We're leaving your grandpa's house tomorrow. He built these shelves himself.
  - He used to play his flute upstairs. He said the notes could call an old day back.
  - Look at the photo before we pack it, and try not to step on your brother's river.
  facePlayer: 1
  promptHeight: 1.6
--- !u!61 &910000302
