  m_Script: {fileID: 11500000, guid: 7a4e1c9b2d8f4e6a9c0b1d2e3f4a5b6c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  speakerName: "看守"
  prompt: "交谈"
  lines:
  - "别往东边撞了。那扇闸门今早突然灭了，谁都过不去。"
  - "北边的告示屏上有记录。南边那个旅人说，他看见石狮子的眼睛熄掉了。"
  facePlayer: 1
  promptHeight: 1.25
